# ─────────────────────────────────────────────────────────────
# Creative Rooms — environment variables
# Copy this file to `.env` and fill in real values.
# Do NOT commit `.env` — it is in `.gitignore`.
# ─────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
#
# API server / Drizzle (`pnpm --filter @workspace/db run push`):
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
#
# Supabase migrations (`pnpm run db:supabase:migrate`) — set in artifacts/creative-rooms/.env:
#   Session pooler (port 5432, IPv4-friendly), Dashboard → Connect:
#   postgresql://postgres.[project-ref]:PASSWORD@aws-0-[region].pooler.supabase.com:5432/postgres
# Direct db.[ref].supabase.co often fails with ENOTFOUND on IPv4-only networks.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Supabase browser client (artifacts/creative-rooms/.env — Dashboard → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── Auth (Clerk) ─────────────────────────────────────────────
# Backend SDK keys (server-side only). Get them from
# https://dashboard.clerk.com → API Keys.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Frontend SDK key — must be prefixed with VITE_ so Vite exposes
# it to the browser bundle at build time. Usually the same value
# as CLERK_PUBLISHABLE_KEY above.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...


# ── Sessions ─────────────────────────────────────────────────
# Long random string used to sign session cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string


# ── Service ports ────────────────────────────────────────────
# Each service reads its port from PORT. In local dev you can
# leave these as-is; the dev scripts will export them. Override
# only if there is a collision.
#
# Web frontend (Vite dev/preview server; default 5173 if unset):
PORT=5173
#
# API server (Express + WebSocket):
# PORT=8080


# ── Frontend build ───────────────────────────────────────────
# Path the web app is mounted at. Use "/" unless the app is
# served from a sub-path behind your reverse proxy.
BASE_PATH=/


# ── Node environment ─────────────────────────────────────────
# Standard. Leave unset in dev; set to "production" in prod.
# NODE_ENV=production
